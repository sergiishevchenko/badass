#!/bin/sh
#
# _sshevche-4 - leaf / VTEP, Part 3, serves _sshevche-3_host.
#
#   eth0     10.1.1.10/30  link to the Route Reflector _sshevche-1
#   lo       1.1.1.4/32    router identity, BGP source and VXLAN tunnel endpoint
#   vxlan10  VNI 10        local 1.1.1.4, no static peer, nolearning:
#                          remote MAC addresses come from BGP EVPN, not flooding
#   br0                    bridge with two ports: eth1 and vxlan10
#   eth1     no IP         port to _sshevche-3_host, acts as a switch port
#
# OSPF area 0 (underlay)
#   advertises the link and the loopback, so the other loopbacks are reachable.
#
# BGP AS 65000 (overlay control plane)
#   iBGP session to the Route Reflector 1.1.1.1, sourced from lo.
#   no bgp default ipv4-unicast  only EVPN routes are exchanged
#   advertise-all-vni            announces VNI 10 (type 3) and the MAC
#                                addresses of the local host (type 2)
#
# FRR is configured through vtysh and saved with write memory.

ip addr add 10.1.1.10/30 dev eth0
ip link set eth0 up
ip link set eth1 up

ip addr add 1.1.1.4/32 dev lo
ip link set lo up

ip link add vxlan10 type vxlan id 10 dstport 4789 local 1.1.1.4 nolearning
ip link set vxlan10 up

brctl addbr br0
brctl addif br0 vxlan10
brctl addif br0 eth1
ip link set br0 up

vtysh << 'EOF'
configure terminal
!
hostname _sshevche-4
!
router ospf
 network 10.1.1.8/30 area 0
 network 1.1.1.4/32 area 0
!
router bgp 65000
 bgp router-id 1.1.1.4
 no bgp default ipv4-unicast
 !
 neighbor 1.1.1.1 remote-as 65000
 neighbor 1.1.1.1 update-source lo
 !
 address-family l2vpn evpn
  neighbor 1.1.1.1 activate
  advertise-all-vni
 exit-address-family
!
end
write memory
EOF
