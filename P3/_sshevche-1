#!/bin/sh
#
# _sshevche-1 - Route Reflector, Part 3. No VXLAN, no bridge, no hosts.
#
#   eth0  10.1.1.1/30  link to leaf _sshevche-2
#   eth1  10.1.1.5/30  link to leaf _sshevche-3
#   eth2  10.1.1.9/30  link to leaf _sshevche-4
#   lo    1.1.1.1/32   router identity, source of the BGP sessions
#
# OSPF area 0 (underlay)
#   advertises the three links and the loopback, so every router can reach
#   every loopback 1.1.1.1-4.
#
# BGP AS 65000 (overlay control plane)
#   iBGP sessions to the leaf loopbacks 1.1.1.2-4, sourced from lo.
#   no bgp default ipv4-unicast  only EVPN routes are exchanged
#   address-family l2vpn evpn    activates EVPN with each leaf
#   route-reflector-client       reflects EVPN routes (type 2 MAC/IP,
#                                type 3 VNI membership) from one leaf
#                                to the others, so leaves need no full mesh
#
# FRR is configured through vtysh and saved with write memory.

ip addr add 10.1.1.1/30 dev eth0
ip addr add 10.1.1.5/30 dev eth1
ip addr add 10.1.1.9/30 dev eth2
ip link set eth0 up
ip link set eth1 up
ip link set eth2 up

ip addr add 1.1.1.1/32 dev lo
ip link set lo up

vtysh << 'EOF'
configure terminal
!
hostname _sshevche-1
!
router ospf
 network 10.1.1.0/30 area 0
 network 10.1.1.4/30 area 0
 network 10.1.1.8/30 area 0
 network 1.1.1.1/32 area 0
!
router bgp 65000
 bgp router-id 1.1.1.1
 no bgp default ipv4-unicast
 !
 neighbor 1.1.1.2 remote-as 65000
 neighbor 1.1.1.2 update-source lo
 neighbor 1.1.1.3 remote-as 65000
 neighbor 1.1.1.3 update-source lo
 neighbor 1.1.1.4 remote-as 65000
 neighbor 1.1.1.4 update-source lo
 !
 address-family l2vpn evpn
  neighbor 1.1.1.2 activate
  neighbor 1.1.1.2 route-reflector-client
  neighbor 1.1.1.3 activate
  neighbor 1.1.1.3 route-reflector-client
  neighbor 1.1.1.4 activate
  neighbor 1.1.1.4 route-reflector-client
 exit-address-family
!
end
write memory
EOF
