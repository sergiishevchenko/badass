#!/bin/sh
#
# _sshevche-3_host - host behind the leaf _sshevche-4, Part 3.
#
#   eth0  20.1.1.3/24  connected to eth1 of _sshevche-4
#
# All three hosts share 20.1.1.0/24 over VXLAN VNI 10. The host has no FRR
# and no VXLAN: the leaves carry its frames to the other hosts.

ip addr add 20.1.1.3/24 dev eth0
ip link set eth0 up
