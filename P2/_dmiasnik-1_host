#!/bin/sh
#
# _dmiasnik-1_host - host behind the router _dmiasnik-1, Part 2.
#
#   eth0  30.1.1.1/24  connected to eth1 of _dmiasnik-1
#
# Shares one L2 segment with _dmiasnik-2_host (30.1.1.2) through the VXLAN
# tunnel. The host knows nothing about the tunnel and needs no extra setup.

ip addr add 30.1.1.1/24 dev eth0
ip link set eth0 up
