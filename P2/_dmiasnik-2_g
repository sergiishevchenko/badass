#!/bin/sh
#
# _dmiasnik-2 - router, Part 2, multicast VXLAN.
#
#   eth0     10.1.1.2/24  underlay link to _dmiasnik-1, carries VXLAN UDP packets
#   vxlan10  VNI 10       joins multicast group 239.1.1.1, UDP port 4789, via eth0
#   br0                   bridge with two ports: eth1 and vxlan10
#   eth1     no IP        port to _dmiasnik-2_host, acts as a switch port
#
# No peer address is configured: BUM traffic (broadcast, unknown unicast,
# multicast) is sent to the group, every router in the group receives it,
# and remote MAC addresses are learned from the replies.

ip addr add 10.1.1.2/24 dev eth0
ip link set eth0 up

ip link add vxlan10 type vxlan id 10 group 239.1.1.1 dstport 4789 dev eth0
ip link set vxlan10 up

brctl addbr br0
brctl addif br0 vxlan10
brctl addif br0 eth1
ip link set br0 up
ip link set eth1 up
